LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_DIMENSION           ICON                    "dimension.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_DIMENSION MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                IDM_NEW
        MENUITEM "&Open\tCtrl+O",               IDM_OPEN
        MENUITEM "&Save\tCtrl+S",               IDM_SAVE
        MENUITEM "Save &As\tCtrl+Shift+S",      IDM_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "E&xport",                     ID_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Undo\tCtrl+Z",                ID_ACTION_UNDO
        MENUITEM "Redo\tCtrl+Y",                ID_ACTION_REDO
        MENUITEM SEPARATOR
        MENUITEM "Select All\tCtrl+A",          ID_SHAPE_SELECT_ALL
        MENUITEM "&Delete\tDel",                ID_SHAPE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Source Editor\tCtrl+E",      IDM_EDIT
        MENUITEM SEPARATOR
        POPUP "&Toolbox"
        BEGIN
            MENUITEM "Cursor\tV",                   ID_TOOLBOX_CURSOR
            MENUITEM "Rectangle\tR",                ID_TOOLBOX_RECTANGLE
            MENUITEM "Ellipse\tO",                  ID_TOOLBOX_ELLIPSE
            MENUITEM "Line\tL",                     ID_TOOLBOX_LINE
            MENUITEM "&Path\tP",                    ID_TOOLBOX_PATH
        END
        POPUP "Time&line"
        BEGIN
            MENUITEM "Play\tEnter",                 ID_TIMELINE_PLAY
            MENUITEM "Stop\tEnter",                 ID_TIMELINE_STOP
            MENUITEM SEPARATOR
            MENUITEM "Next\t.",                     ID_TIMELINE_NEXT
            MENUITEM "Previous\t,",                 ID_TIMELINE_PREVIOUS
            MENUITEM SEPARATOR
            MENUITEM "New\tF7",                     ID_TIMELINE_NEW
            MENUITEM "Duplicate\tF6",               ID_TIMELINE_DUPLICATE
            MENUITEM "Extend\tF5",                  ID_TIMELINE_EXTEND
            MENUITEM "Delete\tCtrl+Delete",         ID_TIMELINE_DELETE
            MENUITEM SEPARATOR
            MENUITEM "L&oop",                       ID_TIMELINE_LOOP
        END
        POPUP "&Brush"
        BEGIN
            MENUITEM "I&ncrease\t]",                ID_BRUSH_INCREASE
            MENUITEM "&Decrease\t[",                ID_BRUSH_DECREASE
            MENUITEM "Reset\t=",                    ID_BRUSH_RESET
            MENUITEM SEPARATOR
            MENUITEM "&Colors\tCtrl+Shift+C",       ID_BRUSH_COLORS
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Dimension\tAlt+?",     IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Dimension &Wiki",             ID_HELP_WIKI
        MENUITEM "&Changelog",                  ID_HELP_CHANGELOG
    END
END

IDR_SHAPE_ACTIONS MENU
BEGIN
    POPUP "ContextMenu"
    BEGIN
        MENUITEM "Select &All\tCtrl+A", ID_SHAPE_SELECT_ALL
        MENUITEM "Deselect &All\tCtrl+Shift+A", ID_SHAPE_DESELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Delete\tDel", ID_SHAPE_DELETE
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_DIMENSION ACCELERATORS
BEGIN
    "Y",            ID_ACTION_REDO,         VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_ACTION_REDO,         VIRTKEY, SHIFT, CONTROL, NOINVERT
    "Z",            ID_ACTION_UNDO,         VIRTKEY, CONTROL, NOINVERT
    "C",            ID_BRUSH_COLORS,        VIRTKEY, SHIFT, CONTROL, NOINVERT
    "[",            ID_BRUSH_DECREASE,      ASCII,  NOINVERT
    "]",            ID_BRUSH_INCREASE,      ASCII,  NOINVERT
    "=",            ID_BRUSH_RESET,         ASCII,  NOINVERT
    VK_DELETE,      ID_SHAPE_DELETE,        VIRTKEY, NOINVERT
    "A",            ID_SHAPE_SELECT_ALL,    VIRTKEY, CONTROL, NOINVERT
    "A",            ID_SHAPE_DESELECT_ALL,  VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_DELETE,      ID_TIMELINE_DELETE,     VIRTKEY, CONTROL, NOINVERT
    VK_F6,          ID_TIMELINE_DUPLICATE,  VIRTKEY, NOINVERT
    VK_F7,          ID_TIMELINE_NEW,        VIRTKEY, NOINVERT
    ".",            ID_TIMELINE_NEXT,       ASCII,  NOINVERT
    VK_RETURN,      ID_TIMELINE_PLAY,       VIRTKEY, NOINVERT
    ",",            ID_TIMELINE_PREVIOUS,   ASCII,  NOINVERT
    VK_RETURN,      ID_TIMELINE_STOP,       VIRTKEY, NOINVERT
    "V",            ID_TOOLBOX_CURSOR,      VIRTKEY, NOINVERT
    "O",            ID_TOOLBOX_ELLIPSE,     VIRTKEY, NOINVERT
    "L",            ID_TOOLBOX_LINE,        VIRTKEY, NOINVERT
    "P",            ID_TOOLBOX_PATH,        VIRTKEY, NOINVERT
    "R",            ID_TOOLBOX_RECTANGLE,   VIRTKEY, NOINVERT
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "E",            IDM_EDIT,               VIRTKEY, CONTROL, NOINVERT
    "N",            IDM_NEW,                VIRTKEY, CONTROL, NOINVERT
    "O",            IDM_OPEN,               VIRTKEY, CONTROL, NOINVERT
    "S",            IDM_SAVE,               VIRTKEY, CONTROL, NOINVERT
    "S",            IDM_SAVEAS,             VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_F5,          ID_TIMELINE_EXTEND,     VIRTKEY, NOINVERT
END


