IDD_ABOUTBOX DIALOGEX 0, 0, 311, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Dimension"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_DIMENSION,IDC_STATIC,14,14,20,20
    LTEXT           "Dimension",IDC_DIM_TITLE,42,14,114,8,SS_NOPREFIX
