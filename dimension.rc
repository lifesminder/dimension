    EDITTEXT        IDC_NEW_SIZE_H,120,23,81,12,ES_CENTER | ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_NEW_FPS,35,39,70,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "FPS",IDC_STATIC,18,41,15,8
    CONTROL         "",IDC_NEW_FPS_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,106,38,11,13
END

